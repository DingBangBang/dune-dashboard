# ---------------------------------------------------------------------------
# Dune API credentials — copy this file to .env and fill in your key.
# Get a key at: Dune -> Settings -> API -> Create new API key
# The key must belong to the account/team that owns the queries (bonnieting).
# Requires an Analyst plan or higher for the Query CRUD endpoints.
# ---------------------------------------------------------------------------
DUNE_API_KEY=your_dune_api_key_here
